#!/usr/bin/env bash
# Pre-commit checks; they mirror CI so problems are caught before a push.
# Enable once per clone:   git config core.hooksPath .githooks
# Emergency bypass (CI still enforces everything):   git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { printf 'pre-commit: %s\n' "$*" >&2; exit 1; }

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# 1. Never commit credential files or captured traffic.
if bad="$(printf '%s\n' "$staged" | grep -Ei '(^|/)(\.env(\..*)?|credentials|credentials\.(env|txt|json|ini)|[^/]*\.credentials|captures/.*|[^/]*\.(pem|key|p12))$')"; then
    fail "refusing to commit credential-like files:
$bad"
fi

# 2. Refuse obvious secret material in what is being added.
added="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"
if printf '%s\n' "$added" | grep -Eq -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' -e 'gh[pousr]_[A-Za-z0-9]{36,}' -e 'github_pat_[A-Za-z0-9_]{40,}'; then
    fail "staged changes contain what looks like a private key or access token"
fi

# 3. Rust checks, only when Rust or build files changed.
if printf '%s\n' "$staged" | grep -Eq '\.rs$|(^|/)Cargo\.(toml|lock)$|^pyproject\.toml$'; then
    command -v cargo >/dev/null || fail "cargo not found"
    echo "pre-commit: cargo fmt --check"
    cargo fmt --check || fail "formatting differs; run 'cargo fmt' and re-stage"
    echo "pre-commit: cargo clippy"
    cargo clippy --all-targets --locked -- -D warnings || fail "clippy reported warnings"
    echo "pre-commit: cargo test"
    cargo test --locked -q || fail "tests failed"
fi

# 4. Shell scripts must parse.
for f in $(printf '%s\n' "$staged" | grep -E '^\.githooks/|\.sh$' || true); do
    bash -n "$f" || fail "syntax error in $f"
done
exit 0
